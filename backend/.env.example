# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Vercel Cron
CRON_SHARED_SECRET=your_cron_shared_secret

# Payments & Integrations
RESEND_API_KEY=your_resend_key
EMAIL_FROM=Baytak Noor <orders@your-domain.example>
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
META_APP_SECRET=your_meta_app_secret

# Turnstile (for public routes)
TURNSTILE_SECRET_KEY=your_turnstile_secret
PUBLIC_CHECKOUT_ENABLED=false

# App Configuration
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:4173,https://your-storefront.example,https://your-admin.example

# Configure in the Vercel backend project (never in static frontend code):
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, CRON_SHARED_SECRET
# RESEND_API_KEY, EMAIL_FROM, WHATSAPP_TOKEN, WHATSAPP_PHONE_ID,
# WHATSAPP_VERIFY_TOKEN, META_APP_SECRET